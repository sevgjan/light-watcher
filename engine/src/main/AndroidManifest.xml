<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A loopback socket to the phone's own debug bridge. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Closes other apps' background processes. A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- The SMS code overlay. Both are off until Watcher's settings switch grants them over the debug bridge. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The Bluetooth pairing helper: LightOS's own pairing prompt crashes, so Watcher takes the key a car or
         keyboard shows. Off until Watcher's settings switch grants them over the debug bridge. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The clock shortcuts: a quiet service keeps Watcher listening for the screen, and usage access tells
         when LightOS's clock is in front. Usage access and draw-over-apps come from Watcher's switch over the
         debug bridge. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Night Wi-Fi: whether Wi-Fi is on before switching it off (switching goes through the debug bridge). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Sees the apps that have a launcher icon, without asking for every package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.lightos" />
    </queries>

    <application>
        <!-- Hands the engine the application context at process start. -->
        <provider
            android:name="io.github.sevgjan.watcher.engine.EngineInit"
            android:authorities="${applicationId}.watcher-engine"
            android:exported="false" />

        <!-- Double-press the side button to flip between the last two apps. Off until Watcher's settings switch enables it. -->
        <service
            android:name="io.github.sevgjan.watcher.engine.AppSwitchService"
            android:exported="true"
            android:label="@string/app_switch_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_switch_service" />
        </service>

        <!-- Whether LightOS's clock is on screen, for the clock shortcuts and for apps that draw on the clock. -->
        <service
            android:name="io.github.sevgjan.watcher.engine.ClockWatchService"
            android:exported="true"
            android:label="@string/clock_watch_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clock_watch_service" />
        </service>

        <!-- Answers "is the clock showing?" for apps that draw on it. Only that yes or no, to anyone who asks. -->
        <provider
            android:name="io.github.sevgjan.watcher.engine.ClockProvider"
            android:authorities="io.github.sevgjan.watcher.clock"
            android:exported="true" />

        <!-- Two app shortcuts beside the home circle on LightOS's clock. -->
        <service
            android:name="io.github.sevgjan.watcher.engine.ShortcutService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's two app shortcuts on the lock screen clock when the screen turns on." />
        </service>

        <!-- Night Wi-Fi's alarms: only Watcher sets them. -->
        <receiver
            android:name="io.github.sevgjan.watcher.engine.NightWifiReceiver"
            android:exported="false" />

        <receiver
            android:name="io.github.sevgjan.watcher.engine.ShortcutBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Only gets pairing requests while BLUETOOTH_CONNECT is granted. Exported because the Bluetooth app
             (not the system) sends them; the receiver checks the device is really being paired. -->
        <receiver
            android:name="io.github.sevgjan.watcher.engine.PairingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.PAIRING_REQUEST" />
            </intent-filter>
        </receiver>

        <!-- The key entry a pairing request opens. Only Watcher starts it. -->
        <activity
            android:name="io.github.sevgjan.watcher.engine.PairingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Only gets texts while RECEIVE_SMS is granted; it ignores everything not from the bank. -->
        <receiver
            android:name="io.github.sevgjan.watcher.engine.SmsCodeReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
